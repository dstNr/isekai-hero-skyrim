<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Isekai Hero</moduleName>
  <!-- The banner across the installer. The threat readings are the one thing that is
       visible without opening a menu, so they are what the mod looks like in play. -->
  <moduleImage path="fomod\images\threat-labels.png"/>

  <!-- GENERATED by tools/make-fomod.mjs - do not edit by hand. -->

  <!-- Everything that is not a setting. The ini is the only file this installer has an
       opinion about; it is chosen below. -->
  <requiredInstallFiles>
    <file   source="IsekaiHero.esp"                    destination="IsekaiHero.esp"/>
    <file   source="LICENSE"                           destination="LICENSE"/>
    <file   source="SKSE\Plugins\IsekaiHeroSKSE.dll"   destination="SKSE\Plugins\IsekaiHeroSKSE.dll"/>
    <folder source="SKSE\Plugins\IsekaiHero"           destination="SKSE\Plugins\IsekaiHero"/>
    <folder source="Sound"                             destination="Sound"/>
  </requiredInstallFiles>

  <installSteps order="Explicit">
    <installStep name="Interface">
      <optionalFileGroups order="Explicit">
        <group name="How the System draws itself" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Built-in">
              <description>The interface the mod draws itself. Needs nothing else, works everywhere the mod does.</description>
              <image path="fomod\images\builtin.png"/>
              <files/>
              <typeDescriptor><type name="Recommended"/></typeDescriptor>
            </plugin>
            <plugin name="PrismaUI">
              <description>Renders the whole interface as a web page instead: the same screens, laid out with HTML and CSS. REQUIRES the PrismaUI framework to be installed separately - without it the mod silently falls back to the built-in interface, so this is safe to pick either way. This is the same patch that used to be a separate download.</description>
              <image path="fomod\images\prismaui.png"/>
              <files>
                <!-- The icons are the same files the built-in path installs. Installed
                     twice from one source rather than shipped twice: the icon set is
                     almost the entire size of both archives. -->
                <file   source="PrismaUI\views\IsekaiHero\index.html"
                        destination="PrismaUI\views\IsekaiHero\index.html"/>
                <folder source="SKSE\Plugins\IsekaiHero\icons"
                        destination="PrismaUI\views\IsekaiHero\icons"/>
              </files>
              <typeDescriptor><type name="Optional"/></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>


    <installStep name="Start">
      <optionalFileGroups order="Explicit">
        <group name="When the System wakes up" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Standard">
              <description>The System boots itself the first time you load into the world.</description>
              
              <files/>
              <conditionFlags>
                <flag name="start">standard</flag>
              </conditionFlags>
              <typeDescriptor><type name="Recommended"/></typeDescriptor>
            </plugin>
            <plugin name="Alternate start">
              <description>For a start that opens somewhere the System's boot sequence does not belong — a modern-world prologue, a dream, a cell. Nothing happens until you press the System hotkey yourself.</description>
              
              <files/>
              <conditionFlags>
                <flag name="start">alternate-start</flag>
              </conditionFlags>
              <typeDescriptor><type name="Optional"/></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>

    <installStep name="Threat readings">
      <optionalFileGroups order="Explicit">
        <group name="Readings over enemies" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Show them">
              <description>Name, level, health and a verdict over anything that is fighting you or that you aim at. F10 hides them for a screenshot.</description>
              <image path="fomod\images\threat-labels.png"/>
              <files/>
              <conditionFlags>
                <flag name="hud">default</flag>
              </conditionFlags>
              <typeDescriptor><type name="Recommended"/></typeDescriptor>
            </plugin>
            <plugin name="Quiet HUD">
              <description>Nothing floating over enemies. Everything else is unchanged, and F10 still switches the readings back on mid-game if you change your mind.</description>
              
              <files/>
              <conditionFlags>
                <flag name="hud">quiet</flag>
              </conditionFlags>
              <typeDescriptor><type name="Optional"/></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>

  <!-- The two answers above pick one of the generated inis. Every combination is listed,
       so there is no path through the installer that leaves the settings file out. -->
  <conditionalFileInstalls>
    <patterns>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="start" value="standard"/>
          <flagDependency flag="hud" value="default"/>
        </dependencies>
        <files>
          <file source="SKSE\Plugins\IsekaiHero.ini" destination="SKSE\Plugins\IsekaiHero.ini"
                priority="1"/>
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="start" value="standard"/>
          <flagDependency flag="hud" value="quiet"/>
        </dependencies>
        <files>
          <file source="fomod-presets\standard-quiet\IsekaiHero.ini" destination="SKSE\Plugins\IsekaiHero.ini"
                priority="1"/>
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="start" value="alternate-start"/>
          <flagDependency flag="hud" value="default"/>
        </dependencies>
        <files>
          <file source="fomod-presets\alternate-start\IsekaiHero.ini" destination="SKSE\Plugins\IsekaiHero.ini"
                priority="1"/>
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="start" value="alternate-start"/>
          <flagDependency flag="hud" value="quiet"/>
        </dependencies>
        <files>
          <file source="fomod-presets\alternate-start-quiet\IsekaiHero.ini" destination="SKSE\Plugins\IsekaiHero.ini"
                priority="1"/>
        </files>
      </pattern>
    </patterns>
  </conditionalFileInstalls>
</config>
