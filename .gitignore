# --- C++ SKSE plugin build ---
build/
dist/
vcpkg_installed/
*.user
*.pdb
build.log
build.err.log
build.pid

# --- Papyrus archive (kept local only) ---
# The archive itself is no longer carried in main; it lives in the tag papyrus-v1.0.
# These rules remain so a leftover local papyrus/ can never be added by accident:
# third-party modder-resource sources and compiled output are not redistributable.
papyrus/Scripts/SourceDeps/*.psc
papyrus/Scripts/SourceDeps/*.bsa
papyrus/Scripts/*.pex

# --- Icon sources ---
# Only the flat, shipped 512x512 PNGs in icons/ are tracked. The generator's
# full-resolution output is kept beside them for re-exports but never redistributed
# (build.bat and both package scripts copy icons\*.png non-recursively anyway).
icons/_src/
icons/Shop/

# --- Editor / OS ---
*.bak
*.tmp
Thumbs.db
.DS_Store

# A stray folder some tool created from a mis-parsed -o flag. Not ours, not shipped.
/-o/

# Claude Code: the shared agreements and skills are tracked, the per-machine
# permission rules are not - they carry local paths and the author name.
.claude/settings.local.json

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Per-plan working state, never part of the record — git history is.
.superpowers/
