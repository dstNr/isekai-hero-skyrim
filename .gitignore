# --- Sound assets (likely from a licensed SFX pack) ---
# Kept local: committing them to a public repo would redistribute them, which the
# pack's licence almost certainly forbids. Deployment copies them straight into the
# game's Data\Sound folder instead.
sounds/

# --- C++ SKSE plugin build ---
build/
vcpkg_installed/
*.user
*.pdb
build.log
build.err.log
build.pid

# --- Papyrus archive (kept local only) ---
# Third-party modder-resource sources + compiled output are not redistributed.
papyrus/Scripts/SourceDeps/*.psc
papyrus/Scripts/SourceDeps/*.bsa
papyrus/Scripts/*.pex

# --- Editor / OS ---
*.bak
*.tmp
Thumbs.db
.DS_Store
